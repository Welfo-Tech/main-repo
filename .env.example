# copy this file to .env and fill in the values
# never commit the .env file

# neon database url - get this from your neon project dashboard
# format: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/welfo?sslmode=require

# jwt - generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-random-string

# grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# alertmanager - telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# next.js frontend env vars
NEXT_PUBLIC_API_URL=http://localhost:4000
