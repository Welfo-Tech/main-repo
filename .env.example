# copy this file to .env and fill in the values
# never commit the .env file

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (default when using docker compose):
DATABASE_URL=postgresql://welfo:welfo@localhost:5432/welfo
# Neon production — uncomment and replace:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/welfo?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-random-string

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ── Telegram alerts (optional — leave as-is if not set up) ───────────────────
TELEGRAM_BOT_TOKEN=placeholder
TELEGRAM_CHAT_ID=0

# ── Frontend ──────────────────────────────────────────────────────────────────
# for Docker builds — default is http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
