# Copy this to .env and fill in values
# DATABASE_URL and JWT_SECRET are required — everything else has a default

DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/welfo?sslmode=require

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars

# Optional — defaults shown
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
