{
  "name": "@welfo/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@repo/db": "*",
    "dotenv": "^16.5.0",
    "hono": "^4.7.11",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
