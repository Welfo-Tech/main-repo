generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATIONS
  FINANCE
  TECHNICIAN
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  DISTRIBUTOR
  DEALER
  SERVICE_PARTNER
}

enum OrganizationTier {
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum ProductCategory {
  ENDOSCOPE
  FIBER_OPTIC
  IMAGING_DEVICE
  OTHER
}

enum ProductStatus {
  UNREGISTERED
  REGISTERED
  IN_SERVICE
  UNDER_REPAIR
  RETIRED
  LOST
  SCRAPPED
}

enum ServiceCaseType {
  REPAIR
  SPARE_DEPLOYMENT
  INSPECTION
  WARRANTY_CLAIM
}

enum ServiceCaseStatus {
  DRAFT
  INTAKE
  ASSIGNED
  UNDER_ASSESSMENT
  AWAITING_QUOTE_APPROVAL
  WORK_AUTHORIZED
  IN_REPAIR
  QC_PENDING
  QC_PASSED
  QC_FAILED
  DISPATCH_READY
  DISPATCHED
  DELIVERED
  CLOSED
  ON_HOLD
  IRREPAIRABLE
  QUOTE_REJECTED
  CANCELLED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  INTAKE_RECEIVED
  CONVERTED
  REJECTED
  DEFERRED
}

enum TicketUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum QuoteStatus {
  DRAFT
  UNDER_REVIEW
  SENT
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum ApprovalMethod {
  EMAIL
  PHONE
  PORTAL
  IN_PERSON
}

enum QuoteLineItemType {
  PART
  LABOR
  SHIPPING
  OTHER
}

enum GstType {
  CGST_SGST
  IGST
  EXEMPT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  CANCELLED
  WRITTEN_OFF
}

enum PaymentStatus {
  RECORDED
  VERIFIED
  RECONCILED
  DISPUTED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  UPI
  CARD
}

enum DispatchDirection {
  INBOUND
  OUTBOUND
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum RepairEventType {
  OBSERVATION
  PART_REPLACED
  TEST_PERFORMED
  FAULT_IDENTIFIED
  NOTE
  CORRECTION
}

enum CaseActivityType {
  STATUS_CHANGE
  NOTE
  CUSTOMER_COMMUNICATION
  ASSIGNMENT_CHANGE
  DOCUMENT_ADDED
}

enum CaseActivityVisibility {
  INTERNAL
  EXTERNAL
}

enum ActorType {
  ADMIN
  TECHNICIAN
  OPERATIONS
  FINANCE
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

enum AttachmentCategory {
  INTAKE_PHOTO
  QC_PHOTO
  REPAIR_PHOTO
  SIGNED_QUOTE
  DELIVERY_RECEIPT
  INVOICE_DOCUMENT
  CUSTOMER_DOCUMENT
  OTHER
}

enum SlaEventType {
  BREACH_WARNING
  BREACHED
  ESCALATED
  RESOLVED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(255)
  passwordHash String    @db.Text
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  technician       Technician?
  createdCases     ServiceCase[]          @relation("ServiceCaseCreatedBy")
  createdTickets   Ticket[]               @relation("TicketCreatedBy")
  madeAssignments  TechnicianAssignment[] @relation("AssignmentAssignedBy")
  createdQuotes    Quote[]                @relation("QuoteCreatedBy")
  createdInvoices  Invoice[]              @relation("InvoiceCreatedBy")
  recordedPayments Payment[]              @relation("PaymentRecordedBy")
  verifiedPayments Payment[]              @relation("PaymentVerifiedBy")
  uploads          Attachment[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Organization {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(255)
  type             OrganizationType
  tier             OrganizationTier @default(STANDARD)
  gstNumber        String?          @db.VarChar(50)
  panNumber        String?          @db.VarChar(50)
  paymentTermsDays Int              @default(30)
  website          String?          @db.VarChar(255)
  notes            String?          @db.Text
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz
  deletedAt        DateTime?        @db.Timestamptz

  contacts     CustomerContact[]
  products     Product[]
  serviceCases ServiceCase[]
  invoices     Invoice[]
  tickets      Ticket[]

  @@index([name])
  @@index([type])
  @@index([isActive])
  @@map("organizations")
}

model CustomerContact {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(255)
  designation    String?   @db.VarChar(100)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  isPrimary      Boolean   @default(false)
  isActive       Boolean   @default(true)
  passwordHash   String?   @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id])
  serviceCases ServiceCase[]
  tickets      Ticket[]

  @@index([organizationId])
  @@index([email])
  @@map("customer_contacts")
}

model ProductModel {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(255)
  category       ProductCategory
  manufacturer   String          @default("Welfo") @db.VarChar(255)
  description    String?         @db.Text
  specifications Json?           @db.JsonB
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  products   Product[]
  spareParts ProductModelSparePart[]

  @@index([category])
  @@index([name])
  @@map("product_models")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  serialNumber    String        @unique @db.VarChar(255)
  modelId         String?       @db.Uuid
  ownerOrgId      String?       @db.Uuid
  manufactureDate DateTime?     @db.Date
  saleDate        DateTime?     @db.Date
  warrantyExpiry  DateTime?     @db.Date
  status          ProductStatus @default(REGISTERED)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  model        ProductModel?   @relation(fields: [modelId], references: [id])
  ownerOrg     Organization?   @relation(fields: [ownerOrgId], references: [id])
  serviceCases ServiceCase[]

  @@index([serialNumber])
  @@index([ownerOrgId])
  @@index([status])
  @@index([modelId])
  @@map("products")
}

model ProductModelSparePart {
  id      String @id @default(uuid()) @db.Uuid
  modelId String @db.Uuid
  partId  String @db.Uuid

  model ProductModel @relation(fields: [modelId], references: [id])
  part  SparePart    @relation(fields: [partId], references: [id])

  @@unique([modelId, partId])
  @@map("product_model_spare_parts")
}

model Technician {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  employeeId      String   @unique @db.VarChar(50)
  phone           String?  @db.VarChar(50)
  specializations String[] @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  user          User                   @relation(fields: [userId], references: [id])
  assignedCases ServiceCase[]
  assignments   TechnicianAssignment[]
  repairEvents  RepairEvent[]

  @@index([employeeId])
  @@index([isActive])
  @@map("technicians")
}

model ServiceCase {
  id                   String            @id @default(uuid()) @db.Uuid
  caseNumber           String            @unique @db.VarChar(20)
  type                 ServiceCaseType   @default(REPAIR)
  status               ServiceCaseStatus @default(INTAKE)
  isBillable           Boolean           @default(true)
  organizationId       String            @db.Uuid
  contactId            String?           @db.Uuid
  productId            String            @db.Uuid
  assignedTechnicianId String?           @db.Uuid
  ticketId             String?           @unique @db.Uuid
  priority             CasePriority      @default(NORMAL)
  slaDeadline          DateTime?         @db.Timestamptz
  intakeCondition      String?           @db.Text
  closedAt             DateTime?         @db.Timestamptz
  cancellationReason   String?           @db.Text
  holdReason           String?           @db.Text
  createdBy            String            @db.Uuid
  createdAt            DateTime          @default(now()) @db.Timestamptz
  updatedAt            DateTime          @updatedAt @db.Timestamptz

  organization Organization           @relation(fields: [organizationId], references: [id])
  contact      CustomerContact?       @relation(fields: [contactId], references: [id])
  product      Product                @relation(fields: [productId], references: [id])
  technician   Technician?            @relation(fields: [assignedTechnicianId], references: [id])
  ticket       Ticket?                @relation(fields: [ticketId], references: [id])
  creator      User                   @relation("ServiceCaseCreatedBy", fields: [createdBy], references: [id])
  assignments  TechnicianAssignment[]
  quotes       Quote[]
  invoice      Invoice?
  repairEvents RepairEvent[]
  dispatches   DispatchRecord[]
  activities   CaseActivity[]
  slaEvents    SlaEvent[]

  @@index([caseNumber])
  @@index([organizationId])
  @@index([productId])
  @@index([assignedTechnicianId])
  @@index([status])
  @@index([createdAt])
  @@index([slaDeadline])
  @@map("service_cases")
}

model Ticket {
  id              String        @id @default(uuid()) @db.Uuid
  ticketNumber    String        @unique @db.VarChar(20)
  organizationId  String        @db.Uuid
  contactId       String?       @db.Uuid
  productId       String?       @db.Uuid
  reportedProblem String        @db.Text
  urgency         TicketUrgency @default(NORMAL)
  status          TicketStatus  @default(OPEN)
  createdBy       String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id])
  contact      CustomerContact? @relation(fields: [contactId], references: [id])
  creator      User             @relation("TicketCreatedBy", fields: [createdBy], references: [id])
  serviceCase  ServiceCase?

  @@index([ticketNumber])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

model TechnicianAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  caseId       String    @db.Uuid
  technicianId String    @db.Uuid
  assignedBy   String    @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamptz
  unassignedAt DateTime? @db.Timestamptz
  reason       String?   @db.Text

  case       ServiceCase @relation(fields: [caseId], references: [id])
  technician Technician  @relation(fields: [technicianId], references: [id])
  assigner   User        @relation("AssignmentAssignedBy", fields: [assignedBy], references: [id])

  @@index([caseId])
  @@index([technicianId])
  @@map("technician_assignments")
}

model Quote {
  id              String          @id @default(uuid()) @db.Uuid
  quoteNumber     String          @db.VarChar(20)
  version         Int             @default(1)
  caseId          String          @db.Uuid
  status          QuoteStatus     @default(DRAFT)
  subtotal        Decimal         @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  currency        String          @default("INR") @db.Char(3)
  validUntil      DateTime?       @db.Date
  terms           String?         @db.Text
  approvedByName  String?         @db.VarChar(255)
  approvedAt      DateTime?       @db.Timestamptz
  approvalMethod  ApprovalMethod?
  rejectionReason String?         @db.Text
  createdBy       String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  case      ServiceCase     @relation(fields: [caseId], references: [id])
  creator   User            @relation("QuoteCreatedBy", fields: [createdBy], references: [id])
  lineItems QuoteLineItem[]
  invoice   Invoice?

  @@unique([caseId, version])
  @@index([caseId])
  @@index([status])
  @@index([quoteNumber])
  @@map("quotes")
}

model QuoteLineItem {
  id          String            @id @default(uuid()) @db.Uuid
  quoteId     String            @db.Uuid
  sortOrder   Int               @default(0)
  itemType    QuoteLineItemType
  partId      String?           @db.Uuid
  description String            @db.VarChar(500)
  quantity    Decimal           @db.Decimal(10, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  discountPct Decimal           @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal           @db.Decimal(12, 2)
  taxRate     Decimal           @default(18) @db.Decimal(5, 2)
  hsnCode     String?           @db.VarChar(20)
  gstType     GstType           @default(CGST_SGST)

  quote Quote      @relation(fields: [quoteId], references: [id])
  part  SparePart? @relation(fields: [partId], references: [id])

  @@index([quoteId])
  @@map("quote_line_items")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceNumber      String        @unique @db.VarChar(20)
  caseId             String        @unique @db.Uuid
  quoteId            String?       @unique @db.Uuid
  organizationId     String        @db.Uuid
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime?     @db.Date
  dueDate            DateTime?     @db.Date
  subtotal           Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(12, 2)
  currency           String        @default("INR") @db.Char(3)
  paymentTerms       String?       @db.Text
  cancellationReason String?       @db.Text
  cancelledAt        DateTime?     @db.Timestamptz
  createdBy          String        @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz

  case         ServiceCase      @relation(fields: [caseId], references: [id])
  quote        Quote?           @relation(fields: [quoteId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  creator      User             @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  lineItems    InvoiceLineItem[]
  payments     Payment[]

  @@index([invoiceNumber])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String            @id @default(uuid()) @db.Uuid
  invoiceId   String            @db.Uuid
  sortOrder   Int               @default(0)
  itemType    QuoteLineItemType
  partId      String?           @db.Uuid
  description String            @db.VarChar(500)
  quantity    Decimal           @db.Decimal(10, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  discountPct Decimal           @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal           @db.Decimal(12, 2)
  taxRate     Decimal           @default(18) @db.Decimal(5, 2)
  hsnCode     String?           @db.VarChar(20)
  gstType     GstType           @default(CGST_SGST)

  invoice Invoice    @relation(fields: [invoiceId], references: [id])
  part    SparePart? @relation(fields: [partId], references: [id])

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @db.Date
  method          PaymentMethod
  referenceNumber String?       @db.VarChar(255)
  notes           String?       @db.Text
  status          PaymentStatus @default(RECORDED)
  recordedBy      String        @db.Uuid
  verifiedBy      String?       @db.Uuid
  verifiedAt      DateTime?     @db.Timestamptz
  createdAt       DateTime      @default(now()) @db.Timestamptz

  invoice  Invoice @relation(fields: [invoiceId], references: [id])
  recorder User    @relation("PaymentRecordedBy", fields: [recordedBy], references: [id])
  verifier User?   @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

model SparePart {
  id               String   @id @default(uuid()) @db.Uuid
  partNumber       String   @unique @db.VarChar(100)
  name             String   @db.VarChar(255)
  description      String?  @db.Text
  category         String?  @db.VarChar(100)
  unitPrice        Decimal? @db.Decimal(12, 2)
  currentStock     Int      @default(0)
  reorderThreshold Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  compatibleModels ProductModelSparePart[]
  quoteLineItems   QuoteLineItem[]
  invoiceLineItems InvoiceLineItem[]
  repairEventParts RepairEventPart[]

  @@index([partNumber])
  @@index([name])
  @@index([isActive])
  @@map("spare_parts")
}

model RepairEvent {
  id           String          @id @default(uuid()) @db.Uuid
  caseId       String          @db.Uuid
  technicianId String          @db.Uuid
  eventType    RepairEventType
  description  String          @db.Text
  eventAt      DateTime        @default(now()) @db.Timestamptz
  createdAt    DateTime        @default(now()) @db.Timestamptz

  case       ServiceCase       @relation(fields: [caseId], references: [id])
  technician Technician        @relation(fields: [technicianId], references: [id])
  parts      RepairEventPart[]

  @@index([caseId])
  @@index([technicianId])
  @@index([eventAt])
  @@map("repair_events")
}

model RepairEventPart {
  id            String  @id @default(uuid()) @db.Uuid
  repairEventId String  @db.Uuid
  partId        String  @db.Uuid
  quantity      Decimal @db.Decimal(10, 3)
  notes         String? @db.Text

  repairEvent RepairEvent @relation(fields: [repairEventId], references: [id])
  part        SparePart   @relation(fields: [partId], references: [id])

  @@index([repairEventId])
  @@index([partId])
  @@map("repair_event_parts")
}

model DispatchRecord {
  id               String            @id @default(uuid()) @db.Uuid
  caseId           String            @db.Uuid
  direction        DispatchDirection
  courierName      String?           @db.VarChar(255)
  trackingNumber   String?           @db.VarChar(255)
  dispatchDate     DateTime?         @db.Date
  expectedDelivery DateTime?         @db.Date
  actualDelivery   DateTime?         @db.Date
  fromAddress      Json?             @db.JsonB
  toAddress        Json?             @db.JsonB
  conditionNotes   String?           @db.Text
  status           DispatchStatus    @default(PENDING)

  case ServiceCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([status])
  @@index([trackingNumber])
  @@map("dispatch_records")
}

model CaseActivity {
  id           String                 @id @default(uuid()) @db.Uuid
  caseId       String                 @db.Uuid
  actorId      String?                @db.Uuid
  actorType    ActorType?
  activityType CaseActivityType
  description  String                 @db.Text
  visibility   CaseActivityVisibility @default(INTERNAL)
  metadata     Json?                  @db.JsonB
  createdAt    DateTime               @default(now()) @db.Timestamptz

  case ServiceCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@index([visibility])
  @@map("case_activities")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  entityType    String      @db.VarChar(100)
  entityId      String      @db.Uuid
  action        AuditAction
  actorId       String?     @db.Uuid
  actorType     ActorType?
  ipAddress     String?     @db.VarChar(45)
  beforeState   Json?       @db.JsonB
  afterState    Json?       @db.JsonB
  changedFields String[]
  occurredAt    DateTime    @default(now()) @db.Timestamptz

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@map("audit_logs")
}

model Attachment {
  id            String             @id @default(uuid()) @db.Uuid
  entityType    String             @db.VarChar(100)
  entityId      String             @db.Uuid
  category      AttachmentCategory
  fileUrl       String             @db.Text
  fileName      String             @db.VarChar(255)
  mimeType      String             @db.VarChar(100)
  fileSizeBytes Int?
  uploadedBy    String             @db.Uuid
  uploadedAt    DateTime           @default(now()) @db.Timestamptz

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([entityType, entityId, category])
  @@map("attachments")
}

model SlaEvent {
  id             String       @id @default(uuid()) @db.Uuid
  caseId         String       @db.Uuid
  eventType      SlaEventType
  triggeredAt    DateTime     @default(now()) @db.Timestamptz
  notifiedActors String[]

  case ServiceCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([triggeredAt])
  @@map("sla_events")
}
